# Copy to .env and fill in. .env is git-ignored.
MODEL_PROVIDER=nvidia
# Free key from https://build.nvidia.com (starts with nvapi-)
NVIDIA_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b
# Alternative: MODEL_PROVIDER=local with a loopback llama.cpp server
# LOCAL_LLM_URL=http://127.0.0.1:18080/v1/chat/completions
# LOCAL_LLM_MODEL=
